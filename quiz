const $ = id => document.getElementById(id);

let questions = [];
let answers = {};
let current = 0;
let soundEnabled = true;
let audioContext = null;
let toastTimer = null;
let autoTimer = null;
let startedAt = 0;
let finishedAt = 0;
let quizFinished = false;
const AUTO_NEXT_DELAY = 1700;

function shuffle(array) {
  const result = [...array];

  for (let i = result.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [result[i], result[j]] = [result[j], result[i]];
  }

  return result;
}

function createQuestions() {
  return relations.map((relation,index) => {
    const distractors = shuffle(
      relations.filter(item => item.code !== relation.code)
    ).slice(0,3).map(item => item.code);

    return {
      id:index,
      prompt:relation.desc,
      answer:relation.code,
      choices:shuffle([relation.code,...distractors])
    };
  });
}

function escapeHTML(value) {
  return String(value).replace(/[&<>"']/g,char => ({
    "&":"&amp;",
    "<":"&lt;",
    ">":"&gt;",
    '"':"&quot;",
    "'":"&#39;"
  })[char]);
}

function playTone(frequency=520,duration=.07,type="sine",volume=.035) {
  if (!soundEnabled) return;

  try {
    const AudioCtx = window.AudioContext || window.webkitAudioContext;
    if (!AudioCtx) return;

    if (!audioContext) audioContext = new AudioCtx();
    if (audioContext.state === "suspended") audioContext.resume();

    const oscillator = audioContext.createOscillator();
    const gain = audioContext.createGain();

    oscillator.type = type;
    oscillator.frequency.setValueAtTime(frequency,audioContext.currentTime);

    gain.gain.setValueAtTime(volume,audioContext.currentTime);
    gain.gain.exponentialRampToValueAtTime(
      .001,
      audioContext.currentTime + duration
    );

    oscillator.connect(gain);
    gain.connect(audioContext.destination);

    oscillator.start();
    oscillator.stop(audioContext.currentTime + duration);
  } catch (_) {
    /* Sound is optional. */
  }
}

function playClick() {
  playTone(540,.045,"sine",.018);
}

function playSuccess() {
  playTone(640,.08,"sine",.04);
  setTimeout(() => playTone(850,.12,"sine",.035),65);
}

function playError() {
  playTone(210,.12,"triangle",.035);
}

function showToast(message) {
  $("toastText").textContent = message;
  $("toast").classList.add("show");

  if (toastTimer) clearTimeout(toastTimer);

  toastTimer = setTimeout(() => {
    $("toast").classList.remove("show");
  },2100);
}

function formatTime(totalSeconds) {
  const seconds = Math.max(0,Math.floor(totalSeconds));
  const hours = Math.floor(seconds / 3600);
  const minutes = Math.floor((seconds % 3600) / 60);
  const remainder = seconds % 60;

  if (hours > 0) {
    return [
      String(hours).padStart(2,"0"),
      String(minutes).padStart(2,"0"),
      String(remainder).padStart(2,"0")
    ].join(":");
  }

  return [
    String(minutes).padStart(2,"0"),
    String(remainder).padStart(2,"0")
  ].join(":");
}

function elapsedSeconds() {
  if (!startedAt) return 0;
  return Math.floor(((finishedAt || Date.now()) - startedAt) / 1000);
}

function stopAutoAdvance() {
  if (autoTimer) {
    clearTimeout(autoTimer);
    autoTimer = null;
  }

  $("autoNote").classList.remove("show");
  $("autoBar").classList.remove("run");
  $("autoBar").style.width = "0";
}

function renderRelations() {
  $("relationsGrid").innerHTML = relations.map((relation,index) => `
    <article class="relation"
      style="--accent:${relation.color};animation:enter .45s ${index*.045}s both"
      data-code="${relation.code}">
      <div class="relation-top">
        <div class="relation-icon">${ICONS[relation.icon]}</div>
        <span class="relation-index">NODE ${String(index+1).padStart(2,"0")}</span>
      </div>
      <div class="relation-code" dir="ltr">${escapeHTML(relation.code)}</div>
      <div class="relation-desc">${escapeHTML(relation.desc)}</div>
      <div class="relation-type">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="M5 12h14m-6-6 6 6-6 6"/>
        </svg>
        ${escapeHTML(relation.type)}
      </div>
    </article>
  `).join("");

  document.querySelectorAll(".relation").forEach(card => {
    card.addEventListener("pointermove",event => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mx",`${((event.clientX-rect.left)/rect.width)*100}%`);
      card.style.setProperty("--my",`${((event.clientY-rect.top)/rect.height)*100}%`);
    });

    card.addEventListener("click",() => {
      playClick();
      const relation = relations.find(item => item.code === card.dataset.code);
      showToast(`${relation.code} — ${relation.desc}`);
    });
  });
}

function renderQuestion() {
  stopAutoAdvance();

  const question = questions[current];
  const selected = answers[current];

  $("questionTag").textContent = `QUESTION ${String(current+1).padStart(2,"0")}`;
  $("questionCounter").textContent = `السؤال ${current+1} من ${questions.length}`;
  $("questionText").textContent = question.prompt;

  $("options").innerHTML = question.choices.map((code,index) => {
    const chosen = selected === code;
    const correct = code === question.answer;
    let classes = "option";

    if (selected !== undefined && correct) {
      classes += " correct";
    } else if (chosen && !correct) {
      classes += " wrong";
    }

    let symbol = `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
        <circle cx="12" cy="12" r="8"/>
      </svg>`;

    if (selected !== undefined && correct) {
      symbol = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m5 12 4 4L19 6"/>
        </svg>`;
    } else if (selected !== undefined && chosen) {
      symbol = `
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="m6 6 12 12M18 6 6 18"/>
        </svg>`;
    }

    return `
      <button class="${classes}" type="button" data-code="${escapeHTML(code)}"
        ${selected !== undefined ? "disabled" : ""}>
        <span class="letter">${String.fromCharCode(65+index)}</span>
        <span class="option-text">${escapeHTML(code)}</span>
        <span class="option-symbol">${symbol}</span>
      </button>`;
  }).join("");

  document.querySelectorAll(".option").forEach(button => {
    button.addEventListener("click",() => chooseAnswer(button.dataset.code));
  });

  const feedback = $("feedback");
  feedback.className = "feedback";
  feedback.innerHTML = "";

  if (selected !== undefined) {
    const isCorrect = selected === question.answer;
    feedback.classList.add("show",isCorrect ? "good" : "bad");

    feedback.innerHTML = isCorrect
      ? `<strong>إجابة صحيحة ✓</strong>أحسنت! الرمز الصحيح هو <b dir="ltr">${escapeHTML(question.answer)}</b>.`
      : `<strong>إجابة خاطئة</strong>الإجابة الصحيحة هي <b dir="ltr">${escapeHTML(question.answer)}</b> — ${escapeHTML(question.prompt)}.`;
  }

  $("prevBtn").disabled = current === 0;
  $("nextBtn").disabled = selected === undefined;

  $("nextBtn").innerHTML = current === questions.length-1
    ? `عرض النتيجة <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>`
    : `التالي <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>`;

  updateStats();
  renderQuestionMap();
}

function chooseAnswer(code) {
  if (answers[current] !== undefined || quizFinished) return;

  answers[current] = code;

  const question = questions[current];
  const correct = code === question.answer;

  if (correct) {
    playSuccess();
    showToast("إجابة صحيحة! أحسنت");
  } else {
    playError();
    showToast("تم تسجيل الإجابة ومراجعتها");
  }

  renderQuestion();

  /*
   * Automatically move to the next question after showing
   * the correct answer and feedback for a short period.
   */
  $("autoNote").classList.add("show");
  $("autoText").textContent = current === questions.length-1
    ? "جاري تجهيز التقرير النهائي..."
    : "الانتقال التلقائي للسؤال التالي...";

  $("autoBar").classList.remove("run");
  void $("autoBar").offsetWidth;
  $("autoBar").classList.add("run");

  autoTimer = setTimeout(() => {
    if (current < questions.length-1) {
      current++;
      renderQuestion();
      document.querySelector(".question-card").scrollIntoView({
        behavior:"smooth",
        block:"nearest"
      });
    } else {
      showResults();
    }
  },AUTO_NEXT_DELAY);
}

function updateStats() {
  const answered = Object.keys(answers).length;

  const correct = Object.keys(answers).filter(index =>
    answers[index] === questions[index].answer
  ).length;

  const wrong = answered-correct;
  const progress = Math.round(answered/questions.length*100);
  const accuracy = answered ? Math.round(correct/answered*100) : null;

  $("answeredCount").textContent = answered;
  $("mainProgress").style.width = `${progress}%`;
  $("progressText").textContent = `${progress}%`;
  $("correctCount").textContent = correct;
  $("wrongCount").textContent = wrong;
  $("accuracy").textContent = accuracy === null ? "—" : accuracy;
  $("accuracyUnit").textContent = accuracy === null ? "" : "%";
  $("scoreText").textContent = `${correct} نقاط`;
}

function renderQuestionMap() {
  $("questionMap").innerHTML = questions.map((question,index) => {
    let classes = "mapitem";

    if (index === current) classes += " current";

    if (answers[index] !== undefined) {
      classes += answers[index] === question.answer ? " done" : " missed";
    }

    return `<button class="${classes}" type="button" data-index="${index}"
      aria-label="السؤال ${index+1}">${index+1}</button>`;
  }).join("");

  document.querySelectorAll(".mapitem").forEach(button => {
    button.addEventListener("click",() => {
      playClick();
      stopAutoAdvance();
      current = Number(button.dataset.index);
      renderQuestion();
    });
  });
}

function nextQuestion() {
  if (answers[current] === undefined) return;

  stopAutoAdvance();
  playClick();

  if (current < questions.length-1) {
    current++;
    renderQuestion();
  } else {
    showResults();
  }
}

function gradeText(percentage) {
  if (percentage === 100) return "ممتاز+";
  if (percentage >= 90) return "ممتاز";
  if (percentage >= 80) return "جيد جداً";
  if (percentage >= 70) return "جيد";
  if (percentage >= 60) return "متوسط";
  if (percentage >= 50) return "مقبول";
  return "يحتاج مراجعة";
}

function buildDetailedReport() {
  $("reportList").innerHTML = questions.map((question,index) => {
    const userAnswer = answers[index];
    const correct = userAnswer === question.answer;
    const selectedRelation = relations.find(item => item.code === userAnswer);
    const correctRelation = relations.find(item => item.code === question.answer);

    return `
      <div class="report-item ${correct ? "good" : "bad"}"
        style="animation-delay:${index*.035}s">
        <div class="left">
          <div class="mark">
            ${correct
              ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m5 12 4 4L19 6"/></svg>`
              : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 6 12 12M18 6 6 18"/></svg>`
            }
          </div>
          <div class="desc">
            السؤال ${index+1}: ${escapeHTML(question.prompt)}
            <small>
              إجابتك: ${userAnswer ? escapeHTML(userAnswer) : "لم تتم الإجابة"}
              ${selectedRelation ? " — "+escapeHTML(selectedRelation.desc) : ""}
            </small>
            ${!correct ? `<small>الصحيح: ${escapeHTML(correctRelation.code)} — ${escapeHTML(correctRelation.desc)}</small>` : ""}
          </div>
        </div>
        <div class="answer-code">${correct ? "CORRECT" : "INCORRECT"}</div>
      </div>`;
  }).join("");
}

function showResults() {
  stopAutoAdvance();

  if (quizFinished) {
    $("resultModal").classList.add("show");
    return;
  }

  quizFinished = true;
  finishedAt = Date.now();

  const correct = questions.filter((question,index) =>
    answers[index] === question.answer
  ).length;

  const wrong = questions.length-correct;
  const percentage = Math.round(correct/questions.length*100);
  const time = formatTime(elapsedSeconds());

  $("finalScore").textContent = `${correct}/${questions.length}`;
  $("finalCorrect").textContent = correct;
  $("finalWrong").textContent = wrong;
  $("finalTime").textContent = time;
  $("finalGrade").textContent = gradeText(percentage);
  $("gradeNumber").textContent = `${percentage}%`;
  $("finalDetail").textContent =
    `أجبت عن ${questions.length} أسئلة خلال ${time}. الإجابات الصحيحة ${correct} والخاطئة ${wrong}.`;

  if (percentage === 100) {
    $("resultTitle").textContent = "أداء مثالي!";
    $("resultMessage").textContent = "رائع! أجبت عن جميع الأسئلة بشكل صحيح.";
    playSuccess();
  } else if (percentage >= 70) {
    $("resultTitle").textContent = "أحسنت، أداء جيد!";
    $("resultMessage").textContent = "نتيجتك جيدة. راجع الأخطاء لتحقق الدرجة الكاملة.";
    playSuccess();
  } else {
    $("resultTitle").textContent = "استمر بالتدريب";
    $("resultMessage").textContent = "راجع الإجابات الصحيحة ثم أعد الاختبار لتحسين نتيجتك.";
    playError();
  }

  $("gradeRing").style.background =
    `conic-gradient(var(--cyan) ${percentage*3.6}deg,#ffffff10 0deg)`;

  buildDetailedReport();
  $("resultModal").classList.add("show");

  updateStats();
}

function restartQuiz() {
  stopAutoAdvance();
  playClick();

  current = 0;
  answers = {};
  questions = createQuestions();
  startedAt = Date.now();
  finishedAt = 0;
  quizFinished = false;

  $("resultModal").classList.remove("show");

  renderQuestion();
  updateStats();

  window.scrollTo({top:0,behavior:"smooth"});
  showToast("بدأ اختبار جديد");
}

/* Animated background particle field */
(function initUniverse() {
  const canvas = $("universe");
  const context = canvas.getContext("2d");

  if (!context) return;

  let width = 0;
  let height = 0;
  let particles = [];
  let animationFrame = 0;
  let lastFrame = 0;

  const pointer = {x:-1000,y:-1000};
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  function resize() {
    const ratio = Math.min(window.devicePixelRatio||1,1.7);

    width = window.innerWidth;
    height = window.innerHeight;

    canvas.width = Math.round(width*ratio);
    canvas.height = Math.round(height*ratio);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;

    context.setTransform(ratio,0,0,ratio,0,0);

    const count = Math.min(100,Math.max(28,Math.round(width/14)));

    particles = Array.from({length:count},() => ({
      x:Math.random()*width,
      y:Math.random()*height,
      vx:(Math.random()-.5)*.25,
      vy:(Math.random()-.5)*.25,
      radius:Math.random()*1.7+.5,
      phase:Math.random()*Math.PI*2
    }));
  }

  function draw(time=0) {
    if (document.hidden) {
      animationFrame = requestAnimationFrame(draw);
      return;
    }

    if (time-lastFrame<30) {
      animationFrame = requestAnimationFrame(draw);
      return;
    }

    lastFrame = time;
    context.clearRect(0,0,width,height);

    for (const particle of particles) {
      if (!reduceMotion) {
        particle.x += particle.vx;
        particle.y += particle.vy;
      }

      if (particle.x<0) particle.x=width;
      if (particle.x>width) particle.x=0;
      if (particle.y<0) particle.y=height;
      if (particle.y>height) particle.y=0;

      const distance = Math.hypot(
        particle.x-pointer.x,
        particle.y-pointer.y
      );

      if (distance<130 && !reduceMotion) {
        particle.x += (particle.x-pointer.x)/Math.max(distance,1)*.7;
        particle.y += (particle.y-pointer.y)/Math.max(distance,1)*.7;
      }

      const alpha = .35+(Math.sin(time*.001+particle.phase)+1)*.25;

      context.beginPath();
      context.arc(particle.x,particle.y,particle.radius,0,Math.PI*2);
      context.fillStyle = `rgba(117,208,255,${alpha})`;
      context.fill();
    }

    const maxDistance = width<600 ? 85 : 115;

    for (let i=0;i<particles.length;i++) {
      for (let j=i+1;j<particles.length;j++) {
        const a = particles[i];
        const b = particles[j];
        const distance = Math.hypot(a.x-b.x,a.y-b.y);

        if (distance<maxDistance) {
          context.beginPath();
          context.moveTo(a.x,a.y);
          context.lineTo(b.x,b.y);
          context.strokeStyle = `rgba(128,137,255,${(1-distance/maxDistance)*.16})`;
          context.lineWidth = .7;
          context.stroke();
        }
      }
    }

    animationFrame = requestAnimationFrame(draw);
  }

  window.addEventListener("resize",resize,{passive:true});

  window.addEventListener("pointermove",event => {
    pointer.x = event.clientX;
    pointer.y = event.clientY;
  },{passive:true});

  window.addEventListener("pointerleave",() => {
    pointer.x=-1000;
    pointer.y=-1000;
  });

  resize();
  animationFrame = requestAnimationFrame(draw);
})();

/* UI event handlers */
$("nextBtn").addEventListener("click",nextQuestion);

$("prevBtn").addEventListener("click",() => {
  if (current>0) {
    stopAutoAdvance();
    playClick();
    current--;
    renderQuestion();
  }
});

$("restartTop").addEventListener("click",restartQuiz);
$("againBtn").addEventListener("click",restartQuiz);

$("closeResultBtn").addEventListener("click",() => {
  playClick();
  $("resultModal").classList.remove("show");
  $("reference").scrollIntoView({behavior:"smooth",block:"start"});
});

$("resultModal").addEventListener("click",event => {
  if (event.target===$("resultModal")) {
    $("resultModal").classList.remove("show");
  }
});

$("themeBtn").addEventListener("click",() => {
  playClick();
  document.documentElement.classList.toggle("light");

  const isLight = document.documentElement.classList.contains("light");

  $("themeBtn").title = isLight
    ? "تفعيل المظهر الداكن"
    : "تفعيل المظهر الفاتح";

  showToast(isLight ? "تم تفعيل المظهر الفاتح" : "تم تفعيل المظهر الداكن");
});

$("soundBtn").addEventListener("click",() => {
  soundEnabled = !soundEnabled;

  $("soundIcon").innerHTML = soundEnabled
    ? `<path d="M11 5 6 9H3v6h3l5 4z"/><path d="M15 9a5 5 0 0 1 0 6m3-9a9 9 0 0 1 0 12"/>`
    : `<path d="M11 5 6 9H3v6h3l5 4z"/><path d="m16 9 5 6m0-6-5 6"/>`;

  $("soundBtn").title = soundEnabled ? "إيقاف الأصوات" : "تشغيل الأصوات";

  if (soundEnabled) playClick();

  showToast(soundEnabled ? "تم تشغيل المؤثرات الصوتية" : "تم إيقاف المؤثرات الصوتية");
});

document.addEventListener("keydown",event => {
  if (event.key==="Escape") {
    $("resultModal").classList.remove("show");
  }

  if (event.key==="ArrowLeft" && answers[current]!==undefined) {
    nextQuestion();
  }

  if (event.key==="ArrowRight" && current>0) {
    stopAutoAdvance();
    playClick();
    current--;
    renderQuestion();
  }
});

/* Disable context menu and drag selection for the interface. */
document.addEventListener("contextmenu",event => {
  if (!event.target.closest("input,textarea")) {
    event.preventDefault();
  }
});

document.addEventListener("dragstart",event => {
  event.preventDefault();
});

/* Live timer, updated once per second. */
setInterval(() => {
  if (!startedAt || quizFinished) return;

  const elapsed = formatTime(elapsedSeconds());
  document.title = `QUIZ-TAQ | ${elapsed}`;
},1000);

/* Launch */
questions = createQuestions();
startedAt = Date.now();

renderRelations();
renderQuestion();
updateStats();
</script>
