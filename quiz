}
.light .glass {
  background:linear-gradient(140deg,#ffffffc9,#ffffff8a 60%,#e7e8ff88);
}
.light .option {
  background:#ffffff7a;
}
.light .option-text {
  color:var(--text);
}
.light .letter {
  background:#eeeffa;
}
.light .tag {
  color:var(--muted);
}
.light .relation {
  background:linear-gradient(145deg,#ffffffb8,#ffffff5c);
}
.light .modal {
  background:#d9ddf3bb;
}
.light .toast {
  background:#fffffff2;
}
.light .grade-ring:before {
  background:#f6f7ff;
}

