
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#080b18">
<title>QUIZ-TAQ | Ultimate Quiz</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&display=swap');

:root {
  --bg:#080b18;
  --panel:rgba(19,24,47,.76);
  --panel2:rgba(255,255,255,.045);
  --text:#f6f6ff;
  --muted:#9ba6c8;
  --border:rgba(169,181,255,.17);
  --purple:#9c7bff;
  --cyan:#47e8ff;
  --pink:#ff69c9;
  --green:#5af5b1;
  --red:#ff6586;
  --gold:#ffda83;
  --shadow:0 24px 70px #0005;
  --radius:23px;
}
* {
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
  -webkit-touch-callout:none;
  -webkit-user-select:none;
  user-select:none;
}
input,textarea {
  -webkit-user-select:text;
  user-select:text;
}
html {
  scroll-behavior:smooth;
}
body {
  margin:0;
  min-height:100vh;
  overflow-x:hidden;
  color:var(--text);
  font-family:'Cairo',sans-serif;
  background:
    radial-gradient(ellipse at 10% 0%,#6740bd30,transparent 37%),
    radial-gradient(ellipse at 100% 30%,#00c7e51c,transparent 35%),
    radial-gradient(ellipse at 45% 100%,#ba328f17,transparent 45%),
    var(--bg);
  transition:background .35s,color .35s;
}
button {
  font:inherit;
  cursor:pointer;
  color:inherit;
  -webkit-appearance:none;
  appearance:none;
  outline:none;
}
button:focus {
  outline:none;
}
button:focus-visible {
  outline:2px solid var(--cyan);
  outline-offset:3px;
}
button:disabled {
  cursor:not-allowed;
  opacity:.45;
}
svg {
  width:22px;
  height:22px;
  display:block;
  flex-shrink:0;
}
#universe {
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  z-index:-5;
  pointer-events:none;
}
.aurora {
  position:fixed;
  width:55vw;
  height:55vw;
  min-width:300px;
  min-height:300px;
  border-radius:50%;
  filter:blur(90px);
  opacity:.13;
  z-index:-4;
  pointer-events:none;
  animation:auroraMove 18s ease-in-out infinite alternate;
}
.aurora.a {
  background:#824cff;
  top:-30%;
  left:-15%;
}
.aurora.b {
  background:#00d9e8;
  right:-20%;
  top:20%;
  animation-delay:-7s;
}
.aurora.c {
  background:#ed3da7;
  bottom:-35%;
  left:25%;
  animation-delay:-11s;
}
@keyframes auroraMove {
  0% {transform:translate3d(-5%,0,0) scale(.85)}
  50% {transform:translate3d(10%,8%,0) scale(1.12)}
  100% {transform:translate3d(-4%,15%,0) scale(.95)}
}
.scanlines {
  position:fixed;
  inset:0;
  z-index:-3;
  pointer-events:none;
  opacity:.15;
  background:repeating-linear-gradient(
    to bottom,transparent 0,transparent 3px,#9fa8ff08 4px
  );
}
.grid-floor {
  position:fixed;
  width:160vw;
  height:70vh;
  bottom:-39vh;
  left:-30vw;
  z-index:-3;
  pointer-events:none;
  opacity:.12;
  transform:perspective(450px) rotateX(58deg);
  transform-origin:center top;
  background-image:
    linear-gradient(#7d83ff55 1px,transparent 1px),
    linear-gradient(90deg,#7d83ff55 1px,transparent 1px);
  background-size:55px 55px;
  mask-image:linear-gradient(to bottom,transparent,black 35%,transparent);
}
.orbit {
  position:fixed;
  width:520px;
  height:520px;
  border:1px solid #a59cff15;
  border-radius:50%;
  pointer-events:none;
  z-index:-2;
  top:-320px;
  right:-160px;
  animation:spin 40s linear infinite;
  box-shadow:0 0 0 35px #8b7aff05,0 0 0 85px #8b7aff03;
}
.orbit:before,.orbit:after {
  content:"";
  position:absolute;
  border:1px solid #47e7ff1b;
  border-radius:50%;
  inset:70px;
}
.orbit:after {
  inset:145px;
  border-color:#ff68c720;
}
@keyframes spin {
  to {transform:rotate(360deg)}
}
.app {
  width:min(1200px,100%);
  margin:auto;
  padding:20px 20px 45px;
}
.glass {
  background:linear-gradient(140deg,rgba(255,255,255,.075),rgba(255,255,255,.018) 48%,rgba(134,110,255,.035));
  border:1px solid var(--border);
  box-shadow:var(--shadow),inset 0 1px 0 #ffffff0c;
  backdrop-filter:blur(22px) saturate(135%);
  -webkit-backdrop-filter:blur(22px) saturate(135%);
  border-radius:var(--radius);
}
.topbar {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:15px;
  margin-bottom:23px;
}
.brand {
  display:flex;
  align-items:center;
  gap:12px;
}
.logo {
  width:49px;
  height:49px;
  display:grid;
  place-items:center;
  position:relative;
  overflow:hidden;
  border-radius:16px;
  background:linear-gradient(135deg,#a68aff,#4e52cf 53%,#38dff4);
  box-shadow:0 0 30px #8970ff40;
}
.logo:after {
  content:"";
  position:absolute;
  inset:-60%;
  background:linear-gradient(110deg,transparent 40%,#ffffff85 50%,transparent 60%);
  animation:shine 5s ease-in-out infinite;
}
@keyframes shine {
  0%,35% {transform:translateX(-100%)}
  65%,100% {transform:translateX(100%)}
}
.brand-name {
  font:900 21px Inter,sans-serif;
  letter-spacing:1.2px;
}
.brand-name span {
  color:var(--cyan);
}
.brand-sub {
  font:600 9px Inter,sans-serif;
  letter-spacing:1.5px;
  color:var(--muted);
  margin-top:5px;
}
.actions {
  display:flex;
  gap:8px;
  align-items:center;
}
.btn {
  min-height:43px;
  padding:0 14px;
  display:inline-flex;
  justify-content:center;
  align-items:center;
  gap:8px;
  border:1px solid var(--border);
  border-radius:14px;
  background:#ffffff08;
  color:var(--text);
  transition:transform .2s,border-color .2s,background .2s,box-shadow .2s;
}
.btn:hover {
  transform:translateY(-2px);
  border-color:#a58bff91;
  background:#9879ff16;
  box-shadow:0 8px 25px #876bff12;
}
.btn:active {
  transform:scale(.96);
}
.btn svg {
  width:18px;
  height:18px;
}
.btn.primary {
  background:linear-gradient(110deg,#8060ef,#5b73ef 52%,#28bfd9);
  border-color:#ffffff32;
  color:white;
  box-shadow:0 9px 25px #7660ff24;
}
.btn.icon {
  width:43px;
  padding:0;
}
.hero {
  display:grid;
  grid-template-columns:1.35fr .65fr;
  gap:16px;
  margin-bottom:22px;
}
.hero-main {
  padding:30px;
  position:relative;
  overflow:hidden;
  animation:enter .65s both;
}
.hero-main:before {
  content:"";
  position:absolute;
  left:-70px;
  bottom:-140px;
  width:300px;
  height:300px;
  border-radius:50%;
  border:1px solid #b2a5ff1b;
  box-shadow:0 0 0 28px #8b75ff06,0 0 0 65px #8b75ff04;
  animation:spin 45s linear infinite;
}
.eyebrow {
  display:flex;
  align-items:center;
  gap:9px;
  color:var(--cyan);
  font-size:11px;
  font-weight:800;
}
.status-dot {
  width:7px;
  height:7px;
  background:var(--green);
  border-radius:50%;
  box-shadow:0 0 14px var(--green);
  animation:pulse 2s infinite;
}
@keyframes pulse {
  50% {opacity:.45;box-shadow:0 0 2px var(--green)}
}
.hero h1 {
  font-size:clamp(30px,4vw,47px);
  line-height:1.55;
  margin:14px 0 8px;
  font-weight:900;
  position:relative;
}
.gradient-text {
  background:linear-gradient(100deg,#c3b1ff 5%,#62ecff 52%,#f19fe3 95%);
  background-size:200%;
  animation:gradientMove 7s linear infinite;
  background-clip:text;
  -webkit-background-clip:text;
  color:transparent;
}
@keyframes gradientMove {
  to {background-position:200% center}
}
.hero p {
  font-size:13px;
  line-height:2;
  color:var(--muted);
  max-width:620px;
  position:relative;
}
.hero-tags {
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin-top:20px;
  position:relative;
}
.tag {
  border:1px solid var(--border);
  background:#ffffff05;
  padding:7px 11px;
  border-radius:10px;
  font-size:10px;
  color:#c8c9e9;
  display:flex;
  align-items:center;
  gap:6px;
}
.tag svg {
  width:14px;
  height:14px;
  color:var(--cyan);
}
.hero-side {
  padding:23px;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
  gap:18px;
  animation:enter .8s both;
}
.stat-label {
  font-size:11px;
  color:var(--muted);
}
.big-number {
  font:900 38px Inter,sans-serif;
  margin-top:7px;
}
.big-number small {
  font-size:13px;
  color:var(--muted);
}
.progress {
  height:7px;
  border-radius:20px;
  background:#ffffff12;
  overflow:hidden;
  margin-top:13px;
}
.progress span {
  display:block;
  height:100%;
  width:0;
  background:linear-gradient(90deg,var(--purple),var(--cyan),var(--pink));
  background-size:200%;
  border-radius:20px;
  transition:width .5s;
  box-shadow:0 0 12px #46dfff55;
}
.stat-row {
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:9px;
  font-size:11px;
  color:var(--muted);
}
.stat-row b {
  color:var(--text);
}
.hero-divider {
  height:1px;
  background:var(--border);
}
.section-head {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin:26px 3px 14px;
}
.section-head h2 {
  font-size:17px;
  margin:0;
  font-weight:800;
}
.section-head small {
  color:var(--muted);
  font-size:10px;
}
.section-title {
  display:flex;
  align-items:center;
  gap:10px;
}
.section-title svg {
  width:21px;
  height:21px;
  color:var(--cyan);
}
.quiz-layout {
  display:grid;
  grid-template-columns:minmax(0,1fr) 285px;
  gap:16px;
  align-items:start;
}
.question-card {
  padding:24px;
  min-width:0;
  animation:enter .35s both;
  position:relative;
  overflow:hidden;
}
.question-card:before {
  content:"";
  position:absolute;
  top:0;
  left:10%;
  right:10%;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--cyan),var(--purple),transparent);
  opacity:.6;
}
@keyframes enter {
  from {opacity:0;transform:translateY(13px)}
  to {opacity:1;transform:translateY(0)}
}
.qtop {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:19px;
}
.qtag {
  font:800 10px Inter,sans-serif;
  letter-spacing:1px;
  color:var(--cyan);
  padding:9px 11px;
  background:#42d9e810;
  border:1px solid #42d9e82a;
  border-radius:10px;
}
.qnum {
  font-size:11px;
  color:var(--muted);
}
.question {
  font-size:clamp(19px,2.5vw,25px);
  line-height:1.9;
  margin:0 0 8px;
  font-weight:800;
}
.subquestion {
  color:var(--muted);
  font-size:12px;
  line-height:1.8;
  margin-bottom:20px;
}
.options {
  display:grid;
  gap:10px;
}
.option {
  width:100%;
  min-height:65px;
  padding:12px 14px;
  display:flex;
  align-items:center;
  gap:12px;
  text-align:right;
  color:var(--text);
  background:rgba(255,255,255,.025);
  border:1px solid var(--border);
  border-radius:16px;
  transition:transform .22s,border-color .22s,background .22s,box-shadow .22s;
  animation:optionEnter .35s both;
}
.option:nth-child(2) {animation-delay:.04s}
.option:nth-child(3) {animation-delay:.08s}
.option:nth-child(4) {animation-delay:.12s}
@keyframes optionEnter {
  from {opacity:0;transform:translateX(9px)}
  to {opacity:1;transform:translateX(0)}
}
.option:hover:not(:disabled) {
  transform:translateX(-3px);
  border-color:#a38bff9c;
  background:#9879ff0d;
  box-shadow:0 7px 25px #8c72ff0c;
}
.letter {
  width:34px;
  height:34px;
  flex:0 0 34px;
  display:grid;
  place-items:center;
  border-radius:11px;
  background:#ffffff07;
  border:1px solid var(--border);
  color:#b9a8ff;
  font:800 11px Inter,sans-serif;
}
.option-text {
  flex:1;
  font:800 17px Inter,sans-serif;
  direction:ltr;
  text-align:right;
  letter-spacing:.4px;
}
.option-symbol {
  width:23px;
  height:23px;
  color:#8e98bd;
  transition:color .2s,transform .2s;
}
.option.correct {
  border-color:#56f4b0b5;
  background:#56f4b012;
  box-shadow:0 0 24px #56f4b00a;
}
.option.correct .letter {
  color:var(--green);
  border-color:#56f4b055;
  background:#56f4b014;
}
.option.correct .option-symbol {
  color:var(--green);
  transform:scale(1.15);
}
.option.wrong {
  border-color:#ff6385b0;
  background:#ff638510;
}
.option.wrong .letter {
  color:var(--red);
  border-color:#ff638555;
}
.option.wrong .option-symbol {
  color:var(--red);
}
.feedback {
  display:none;
  margin-top:15px;
  padding:14px 15px;
  border-radius:14px;
  font-size:12px;
  line-height:1.9;
  animation:enter .25s;
}
.feedback.show {
  display:block;
}
.feedback.good {
  background:#56f4b010;
  border:1px solid #56f4b04c;
}
.feedback.bad {
  background:#ff638510;
  border:1px solid #ff63854c;
}
.feedback strong {
  display:block;
  margin-bottom:3px;
}
.auto-note {
  display:none;
  margin-top:11px;
  font-size:10px;
  color:var(--muted);
  align-items:center;
  gap:8px;
}
.auto-note.show {
  display:flex;
}
.auto-track {
  height:4px;
  flex:1;
  background:#ffffff10;
  border-radius:20px;
  overflow:hidden;
}
.auto-track span {
  display:block;
  height:100%;
  width:0;
  background:linear-gradient(90deg,var(--purple),var(--cyan));
  border-radius:20px;
}
.auto-track span.run {
  animation:countdown 1.7s linear forwards;
}
@keyframes countdown {
  from {width:0}
  to {width:100%}
}
.controls {
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-top:21px;
}
.sidepanel {
  padding:20px;
  position:sticky;
  top:14px;
}
.sidepanel h3 {
  font-size:14px;
  margin:0 0 14px;
}
.mini-grid {
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}
.mini-stat {
  padding:13px;
  border-radius:15px;
  border:1px solid var(--border);
  background:var(--panel2);
}
.mini-stat b {
  display:block;
  font:800 23px Inter,sans-serif;
}
.mini-stat span {
  font-size:10px;
  color:var(--muted);
}
.divider {
  height:1px;
  background:var(--border);
  margin:17px 0;
}
.question-map {
  display:grid;
  grid-template-columns:repeat(5,1fr);
  gap:7px;
}
.mapitem {
  aspect-ratio:1;
  border:1px solid var(--border);
  border-radius:10px;
  color:var(--muted);
  background:#ffffff04;
  font:700 11px Inter,sans-serif;
  transition:.2s;
}
.mapitem:hover {
  transform:translateY(-2px);
}
.mapitem.current {
  border-color:var(--purple);
  color:white;
  background:#8c72ff30;
  box-shadow:0 0 17px #8c72ff25;
}
.mapitem.done {
  border-color:#56f4b060;
  color:var(--green);
  background:#56f4b010;
}
.mapitem.missed {
  border-color:#ff638560;
  color:var(--red);
  background:#ff638510;
}
.sidehint {
  font-size:10px;
  line-height:1.9;
  color:var(--muted);
  margin-top:13px;
}
.side-tip {
  display:flex;
  align-items:flex-start;
  gap:10px;
  margin-top:17px;
  padding:12px;
  border:1px solid #48e8ff22;
  border-radius:13px;
  background:#48e8ff06;
}
.side-tip svg {
  width:18px;
  height:18px;
  color:var(--cyan);
}
.side-tip span {
  font-size:10px;
  line-height:1.9;
  color:var(--muted);
}
.tablecard {
  padding:21px;
  margin-top:23px;
  position:relative;
  overflow:hidden;
}
.tablecard:before {
  content:"";
  position:absolute;
  top:0;
  left:20%;
  right:20%;
  height:1px;
  background:linear-gradient(90deg,transparent,var(--purple),var(--cyan),transparent);
}
.relations-grid {
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
}
.relation {
  --accent:var(--cyan);
  position:relative;
  overflow:hidden;
  isolation:isolate;
  padding:17px;
  border:1px solid var(--border);
  border-radius:19px;
  background:linear-gradient(145deg,#ffffff07,#ffffff01 70%);
  transition:transform .3s,border-color .3s,box-shadow .3s;
  min-height:180px;
}
.relation:before {
  content:"";
  position:absolute;
  inset:-1px;
  z-index:-1;
  opacity:0;
  background:radial-gradient(circle at var(--mx,50%) var(--my,50%),color-mix(in srgb,var(--accent) 20%,transparent),transparent 55%);
  transition:opacity .3s;
}
.relation:hover {
  transform:translateY(-5px);
  border-color:color-mix(in srgb,var(--accent) 65%,transparent);
  box-shadow:0 17px 45px #0002,0 0 24px color-mix(in srgb,var(--accent) 10%,transparent);
}
.relation:hover:before {
  opacity:1;
}
.relation-top {
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}
.relation-icon {
  width:51px;
  height:51px;
  display:grid;
  place-items:center;
  border-radius:17px;
  color:var(--accent);
  border:1px solid color-mix(in srgb,var(--accent) 30%,transparent);
  background:color-mix(in srgb,var(--accent) 9%,transparent);
  transition:transform .3s,box-shadow .3s;
}
.relation:hover .relation-icon {
  transform:rotate(-5deg) scale(1.06);
  box-shadow:0 0 25px color-mix(in srgb,var(--accent) 20%,transparent);
}
.relation-icon svg {
  width:27px;
  height:27px;
}
.relation-index {
  font:700 10px Inter,sans-serif;
  color:var(--muted);
}
.relation-code {
  font:900 23px Inter,sans-serif;
  direction:ltr;
  text-align:right;
  margin-top:13px;
  letter-spacing:.6px;
  color:var(--accent);
}
.relation-desc {
  font-size:12px;
  line-height:1.9;
  margin-top:5px;
}
.relation-type {
  display:flex;
  align-items:center;
  gap:6px;
  font-size:10px;
  color:var(--muted);
  margin-top:9px;
}
.relation-type svg {
  width:13px;
  height:13px;
  color:var(--accent);
}

/* Final report */
.modal {
  position:fixed;
  inset:0;
  z-index:20;
  display:none;
  align-items:center;
  justify-content:center;
  padding:15px;
  background:#03040cbd;
  backdrop-filter:blur(14px);
  overflow-y:auto;
}
.modal.show {
  display:flex;
}
.resultbox {
  width:min(700px,100%);
  max-height:94vh;
  overflow-y:auto;
  padding:27px;
  text-align:center;
  animation:enter .35s;
}
.result-icon {
  width:75px;
  height:75px;
  margin:0 auto 14px;
  display:grid;
  place-items:center;
  border:1px solid var(--border);
  border-radius:25px;
  background:linear-gradient(135deg,#8c72ff25,#48e8ff18);
  color:var(--cyan);
  animation:float 3s ease-in-out infinite;
}
.result-icon svg {
  width:36px;
  height:36px;
}
@keyframes float {
  50% {transform:translateY(-7px) rotate(3deg)}
}
.resultbox h2 {
  font-size:24px;
  margin:0 0 7px;
}
.resultbox p {
  font-size:12px;
  color:var(--muted);
  line-height:2;
}
.result-score {
  font:900 48px Inter,sans-serif;
  background:linear-gradient(90deg,#c4b3ff,var(--cyan));
  background-clip:text;
  -webkit-background-clip:text;
  color:transparent;
  margin:10px;
}
.grade-ring {
  width:150px;
  height:150px;
  margin:18px auto;
  border-radius:50%;
  display:grid;
  place-items:center;
  background:conic-gradient(var(--cyan) 0deg,#ffffff10 0deg);
  position:relative;
  box-shadow:0 0 35px #48e8ff12;
  transition:background 1s;
}
.grade-ring:before {
  content:"";
  position:absolute;
  inset:9px;
  background:#10152a;
  border:1px solid var(--border);
  border-radius:50%;
}
.grade-inner {
  position:relative;
  z-index:1;
}
.grade-number {
  font:900 29px Inter,sans-serif;
}
.grade-caption {
  color:var(--muted);
  font-size:10px;
  margin-top:3px;
}
.result-grid {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:9px;
  margin:20px 0;
}
.result-stat {
  padding:14px 7px;
  border:1px solid var(--border);
  border-radius:15px;
  background:var(--panel2);
}
.result-stat svg {
  width:21px;
  height:21px;
  margin:0 auto 7px;
}
.result-stat b {
  display:block;
  font:800 21px Inter,sans-serif;
}
.result-stat span {
  font-size:10px;
  color:var(--muted);
}
.result-stat.success svg {color:var(--green)}
.result-stat.failure svg {color:var(--red)}
.result-stat.clock svg {color:var(--cyan)}
.result-stat.grade svg {color:var(--gold)}
.report-heading {
  text-align:right;
  font-size:14px;
  margin:22px 0 10px;
}
.report-list {
  display:grid;
  gap:8px;
  text-align:right;
}
.report-item {
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  padding:12px 14px;
  border:1px solid var(--border);
  border-radius:13px;
  background:var(--panel2);
  animation:enter .3s both;
}
.report-item .left {
  display:flex;
  align-items:center;
  gap:10px;
}
.report-item .mark {
  width:29px;
  height:29px;
  display:grid;
  place-items:center;
  border-radius:9px;
  flex-shrink:0;
}
.report-item .mark svg {
  width:16px;
  height:16px;
}
.report-item.good .mark {
  color:var(--green);
  background:#56f4b015;
}
.report-item.bad .mark {
  color:var(--red);
  background:#ff638515;
}
.report-item .desc {
  font-size:11px;
  line-height:1.8;
}
.report-item .desc small {
  display:block;
  color:var(--muted);
  font-size:10px;
}
.report-item .answer-code {
  direction:ltr;
  font:800 13px Inter,sans-serif;
  white-space:nowrap;
}
.result-actions {
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
  margin-top:21px;
}
.toast {
  position:fixed;
  z-index:30;
  bottom:22px;
  left:50%;
  transform:translate(-50%,25px);
  opacity:0;
  pointer-events:none;
  display:flex;
  align-items:center;
  gap:9px;
  background:rgba(18,23,44,.95);
  border:1px solid var(--border);
  border-radius:14px;
  padding:12px 17px;
  box-shadow:var(--shadow);
  font-size:12px;
  transition:opacity .25s,transform .25s;
  width:max-content;
  max-width:calc(100% - 28px);
}
.toast.show {
  opacity:1;
  transform:translate(-50%,0);
}
.toast svg {
  width:18px;
  height:18px;
  color:var(--cyan);
}
.footer {
  text-align:center;
  color:var(--muted);
  font-size:10px;
  line-height:2.1;
  margin:29px 0 0;
}
.footer strong {
  font:900 12px Inter,sans-serif;
  letter-spacing:2px;
  color:#b9a9ff;
}
.footer-line {
  width:95px;
  height:1px;
  margin:12px auto;
  background:linear-gradient(90deg,transparent,var(--cyan),var(--purple),transparent);
}

/* Light theme */
.light {
  color-scheme:light;
  --bg:#edf0fc;
  --panel:rgba(255,255,255,.78);
  --panel2:rgba(70,80,130,.045);
  --text:#1c2038;
