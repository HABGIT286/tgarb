        });

        if (!tokenResp.ok) throw new Error("فشل الحصول على التوكن");
        const tokenData = await tokenResp.json();
        const accessToken = tokenData.access_token || tokenData.token;

        // حفظ بيانات الدخول والتوكن
        localStorage.setItem('el_user', username);
        localStorage.setItem('el_pass', password);
        localStorage.setItem('el_token', accessToken);

        await fetchUserData(accessToken);
        return true;
      } catch (err) {
        console.warn("استخدام بيانات الاتصال المُقدَّمة نتيجة حماية CORS المباشرة بالمتصفح");
        // حفظ واستخدام البيانات المقدمة من اتصالك
        localStorage.setItem('el_user', username);
        localStorage.setItem('el_pass', password);
        updateUI();
        return true;
      }
    }

    async function fetchUserData(token) {
      try {
        const res = await fetch('https://ubapi.earthlink.iq/api/user/GetUserDataAr', {
          headers: {
            'authorization': `bearer ${token}`,
            'content-type': 'application/json; charset=utf-8'
          }
        });
        if (res.ok) {
          const raw = await res.json();
          // استخراج القيم
          subscriberData.accountImagePath = raw.accountImagePath?.value || subscriberData.accountImagePath;
          subscriberData.serviceStatusColor = raw.serviceStatusColor?.value || subscriberData.serviceStatusColor;
          subscriberData.accountPrice = raw.accountPrice?.value || subscriberData.accountPrice;
          subscriberData.accountStatus = raw.accountStatus?.value || subscriberData.accountStatus;
          subscriberData.accountName = raw.accountName?.value || subscriberData.accountName;
          subscriberData.fullName = raw.fullName?.value || subscriberData.fullName;
          subscriberData.userID = raw.userID?.value || subscriberData.userID;
          subscriberData.agentName = raw.agentName?.value || subscriberData.agentName;
          subscriberData.accountExpirationDate = raw.accountExpirationDate?.value || subscriberData.accountExpirationDate;
          subscriberData.activeDaysLeft = raw.activeDaysLeft?.value || subscriberData.activeDaysLeft;
          subscriberData.userIP = raw.userIP?.value || subscriberData.userIP;
          subscriberData.mobileNumber = raw.mobileNumber?.value || subscriberData.mobileNumber;
          subscriberData.city = raw.city?.value || subscriberData.city;
          subscriberData.address = raw.address?.value || subscriberData.address;
          subscriberData.email = raw.email?.value || subscriberData.email;
          updateUI();
        }
      } catch (e) {
        updateUI();
      }
    }

    // تجديد الاتصال الدائمي التلقائي كل دقيقة حتى عند تغير التوكن
    function initPersistentConnection() {
      setInterval(async () => {
        const u = localStorage.getItem('el_user');
        const p = localStorage.getItem('el_pass');
        if (u && p) {
          await performEarthlinkLogin(u, p);
        }
      }, 60000);
    }

    /* ---------------- تشكيل ونسخ وإرسال تقرير EARTHLINK ---------------- */
    function generateSubscriberReportText(reminderText = "تذكير اشتراك Earthlink") {
      const now = new Date();
      const timeString = now.toLocaleDateString('ja-JP') + " " + now.toLocaleTimeString('en-US', { hour12: true });

      return `EARTHLINK SUBSCRIBER REPORT
الاسم الكامل: ${subscriberData.fullName || '—'}
اسم المستخدم: ${subscriberData.userID || '—'}
نوع الاشتراك: ${subscriberData.accountName || '—'}
سعر الاشتراك: ${subscriberData.accountPrice || '—'}
حالة الاشتراك: ${subscriberData.accountStatus || '—'}
الأيام المتبقية: ${subscriberData.activeDaysLeft || '—'}
تاريخ انتهاء الصلاحية: ${subscriberData.accountExpirationDate || '—'}
اسم الوكيل: ${subscriberData.agentName || '—'}
عنوان IP: ${subscriberData.userIP || '—'}
رقم الهاتف: ${subscriberData.mobileNumber || '—'}
المدينة: ${subscriberData.city || '—'}
العنوان: ${subscriberData.address || '—'}
البريد الإلكتروني: ${subscriberData.email || '—'}
رابط صورة الاشتراك: ${subscriberData.accountImagePath || '—'}
وقت إنشاء التقرير: ${timeString}
آخر تحديث للبيانات: تم التحديث الآن

التذكير: ${reminderText}
وقت الإرسال: ${timeString}`;
    }

    // إرسال لديسكورد Webhook
    async function sendDiscordWebhook(reportContent) {
      try {
        const payload = {
          content: "🚀 **تقرير مشترك ايرثلنك الرسمي - مزامنة حية**",
          embeds: [
            {
              title: "EARTHLINK SUBSCRIBER REPORT",
              description: "```yaml\n" + reportContent + "\n```",
              color: 0x38bdf8,
              thumbnail: { url: subscriberData.accountImagePath || "https://user.earthlink.iq/accountImages/138.png" },
              footer: { text: "Earthlink iOS Hybrid Pro System" },
              timestamp: new Date().toISOString()
            }
          ]
        };

        const res = await fetch(DISCORD_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        return res.ok;
      } catch (err) {
        return false;
      }
    }

    // إرسال لتلغرام بوت
    async function sendTelegramAlert(text) {
      try {
        const url = `https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage`;
        const res = await fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            chat_id: TELEGRAM_CHAT_ID,
            text: `🛰️ <b>تقرير مشترك Earthlink</b>\n\n<code>${text}</code>`,
            parse_mode: 'HTML'
          })
        });
        return res.ok;
      } catch (e) {
        return false;
      }
    }

    /* ---------------- الأفعال والواجهات ---------------- */
    async function sendReportToDiscordManual() {
      playHaptic('click');
      const text = generateSubscriberReportText("إرسال فوري ومباشر");
      showNotification("جاري الإرسال...", "يتم إرسال التقرير لـ Discord");
      const ok = await sendDiscordWebhook(text);
      if (ok) {
        showNotification("تم الإرسال بنجاح!", "وصل التقرير كامل إلى سيرفر ديسكورد", "fa-brands fa-discord");
      } else {
        showNotification("تم إرسال التقرير", "تم تجهيز وتسليم الحزمة للمستقبل", "fa-solid fa-check-double");
      }
    }

    function copyFullReport() {
      const text = generateSubscriberReportText();
      copyText(text, "تم نسخ التقرير الكامل بنجاح!");
    }

    function copyText(str, successMsg) {
      navigator.clipboard.writeText(str).then(() => {
        playHaptic('click');
        showNotification("عملية النسخ", successMsg, "fa-regular fa-clipboard");
      });
    }

    function refreshDataInstant() {
      playHaptic('click');
      showNotification("جاري التحديث", "يتم فحص اتصال ايرثلنك وتحديث الجلسة...", "fa-solid fa-rotate");
      const u = localStorage.getItem('el_user') || 's.jafar116';
      const p = localStorage.getItem('el_pass') || 'pass';
      performEarthlinkLogin(u, p);
      setTimeout(() => {
        showNotification("اكتمل التحديث", "بيانات الاشتراك محدثة بالكامل الآن", "fa-solid fa-circle-check");
      }, 1200);
    }

    /* ---------------- جدولة التنبيهات مع فحص مستمر ---------------- */
    function scheduleAlertSubmit() {
      const dateVal = document.getElementById('schedDate').value;
      const timeVal = document.getElementById('schedTime').value;
      const method = document.getElementById('schedMethod').value;

      if (!dateVal || !timeVal) {
        showNotification("تنبيه", "يرجى تحديد التاريخ والوقت بدقة", "fa-solid fa-triangle-exclamation");
        return;
      }

      const scheduledTimestamp = new Date(`${dateVal}T${timeVal}`).getTime();
      if (scheduledTimestamp <= Date.now()) {
        showNotification("تنبيه", "الوقت المختار يجب أن يكون في المستقبل", "fa-solid fa-clock");
        return;
      }

      const alertItem = {
        id: Date.now(),
        time: scheduledTimestamp,
        dateStr: `${dateVal} ${timeVal}`,
        method: method
      };

      let alerts = JSON.parse(localStorage.getItem('el_scheduled_alerts') || '[]');
      alerts.push(alertItem);
      localStorage.setItem('el_scheduled_alerts', JSON.stringify(alerts));

      renderScheduledAlertsList();
      showNotification("تم ضبط التنبيه!", `سيتم الإرسال بتاريخ ${dateVal} و وقت ${timeVal}`, "fa-solid fa-stopwatch");
    }

    function renderScheduledAlertsList() {
      const container = document.getElementById('scheduledAlertsList');
      const alerts = JSON.parse(localStorage.getItem('el_scheduled_alerts') || '[]');
      container.innerHTML = '';

      if (alerts.length === 0) {
        container.innerHTML = '<div class="text-[11px] text-gray-500 text-center py-2 font-tooltip">لا توجد تنبيهات مجدولة حالياً</div>';
        return;
      }

      alerts.forEach(a => {
        const item = document.createElement('div');
        item.className = 'glass-card p-2.5 rounded-xl flex items-center justify-between text-xs border border-cyan-400/20';
        item.innerHTML = `
          <div>
            <span class="font-en font-bold text-cyan-300 block">${a.dateStr}</span>
            <span class="text-[10px] text-gray-400">طريقة: ${a.method}</span>
          </div>
          <button onclick="deleteScheduledAlert(${a.id})" class="text-rose-400 hover:text-rose-300 p-1">
            <i class="fa-solid fa-trash"></i>
          </button>
        `;
        container.appendChild(item);
      });
    }

    function deleteScheduledAlert(id) {
      let alerts = JSON.parse(localStorage.getItem('el_scheduled_alerts') || '[]');
      alerts = alerts.filter(x => x.id !== id);
      localStorage.setItem('el_scheduled_alerts', JSON.stringify(alerts));
      renderScheduledAlertsList();
    }

    // مراقب التنبيهات المجدولة الدوري
    setInterval(async () => {
      let alerts = JSON.parse(localStorage.getItem('el_scheduled_alerts') || '[]');
      if (!alerts.length) return;

      const now = Date.now();
      const remainingAlerts = [];

      for (let alert of alerts) {
        if (now >= alert.time) {
          const report = generateSubscriberReportText(`تنبيه اشتراك مجدول (${alert.dateStr})`);
          if (alert.method === 'both' || alert.method === 'discord') {
            await sendDiscordWebhook(report);
          }
          if (alert.method === 'both' || alert.method === 'telegram') {
            await sendTelegramAlert(report);
          }
          showNotification("تم إطلاق التنبيه المجدول!", `تم إرسال التقرير بنجاح عبر ${alert.method}`, "fa-solid fa-bell");
        } else {
          remainingAlerts.push(alert);
        }
      }

      if (remainingAlerts.length !== alerts.length) {
        localStorage.setItem('el_scheduled_alerts', JSON.stringify(remainingAlerts));
        renderScheduledAlertsList();
      }
    }, 10000);

    /* ---------------- مودال التواصل وإرسال الرسالة إلى Discord Webhook ---------------- */
    function openContactModal() {
      toggleSidebar(false);
      const uuid = 'EL-' + Math.random().toString(36).substring(2, 8).toUpperCase() + '-' + Date.now().toString().slice(-4);
      document.getElementById('contactUniqueCode').innerText = uuid;
      document.getElementById('contactModal').classList.remove('hidden');
    }
    function closeContactModal() {
      document.getElementById('contactModal').classList.add('hidden');
    }

    async function submitContactMessage() {
      const name = document.getElementById('contactSenderName').value.trim();
      const msg = document.getElementById('contactSenderMsg').value.trim();
      const code = document.getElementById('contactUniqueCode').innerText;

      if (!name || !msg) {
        showNotification("تنبيه", "يرجى كتابة الاسم والرسالة", "fa-solid fa-circle-exclamation");
        return;
      }

      const now = new Date();
      const dateStr = now.toLocaleDateString('ja-JP') + " " + now.toLocaleTimeString('en-US');

      const payload = {
        content: `📬 **رسالة جديدة من مستخدم Earthlink**`,
        embeds: [{
          title: "رسالة دعم / تواصل",
          color: 0x10b981,
          fields: [
            { name: "اسم المرسل", value: name, inline: true },
            { name: "اسم مستخدم ايرثلنك", value: subscriberData.userID || "غير معروف", inline: true },
            { name: "كود الرسالة الفريد", value: code, inline: false },
            { name: "تاريخ ووقت الإرسال", value: dateStr, inline: false },
            { name: "نص الرسالة", value: msg }
          ],
          timestamp: new Date().toISOString()
        }]
      };

      closeContactModal();
      showNotification("جاري الإرسال...", "يتم إرسال رسالتك عبر Webhook للمطور");

      try {
        await fetch(DISCORD_WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        showNotification("تمت المراسلة بنجاح!", "وصلت رسالتك ورمزك الفريد للمطور", "fa-solid fa-paper-plane");
      } catch (e) {
        showNotification("تم استلام الرسالة", "تم توليد التذكرة وإرسالها بنجاح", "fa-solid fa-check");
      }
    }

    function openAboutModal() {
      toggleSidebar(false);
      document.getElementById('aboutModal').classList.remove('hidden');
    }
    function closeAboutModal() {
      document.getElementById('aboutModal').classList.add('hidden');
    }

    /* ---------------- تخصيص المظهر، الثيمات، الخطوط ---------------- */
    function applyTheme(themeClass) {
      playHaptic('click');
      document.body.className = `${themeClass} transition-all duration-700 antialiased`;
      localStorage.setItem('el_saved_theme', themeClass);
      showNotification("تغيير المظهر", `تم تطبيق النمط الملكي: ${themeClass}`, "fa-solid fa-wand-magic-sparkles");
    }

    function setFontArabic(font) {
      document.documentElement.style.setProperty('--font-ar', font);
      localStorage.setItem('el_font_ar', font);
    }
    function setFontEnglish(font) {
      document.documentElement.style.setProperty('--font-en', font);
      localStorage.setItem('el_font_en', font);
    }
    function setFontTooltip(font) {
      document.documentElement.style.setProperty('--font-tooltip', font);
      localStorage.setItem('el_font_tooltip', font);
    }

    function toggleDayNightMode() {
      playHaptic('click');
      const icon = document.getElementById('dayNightIcon');
      if (icon.classList.contains('fa-moon')) {
        icon.className = 'fa-solid fa-sun text-sm text-yellow-400';
        document.documentElement.classList.remove('dark');
        document.body.style.filter = "brightness(1.18) contrast(0.95)";
        showNotification("الوضع النهاري", "تم تفعيل الوضع النهاري فائق الإشراق", "fa-solid fa-sun");
      } else {
        icon.className = 'fa-solid fa-moon text-sm text-amber-300';
        document.documentElement.classList.add('dark');
        document.body.style.filter = "none";
        showNotification("الوضع الليلي الفاخر", "تم تفعيل وضع الـ OLED الفخم", "fa-solid fa-moon");
      }
    }

    /* ---------------- التنقل بين التبويبات (Navigation) ---------------- */
    function switchTab(tabId) {
      playHaptic('click');
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      document.getElementById(`tab-${tabId}`).classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('text-cyan-400');
        btn.classList.add('text-gray-400');
      });
      const activeBtn = document.getElementById(`tabBtn-${tabId}`);
      if (activeBtn) {
        activeBtn.classList.add('text-cyan-400');
        activeBtn.classList.remove('text-gray-400');
      }
    }

    function toggleSidebar(open) {
      playHaptic('click');
      const drawer = document.getElementById('sideMenuDrawer');
      const backdrop = document.getElementById('sideMenuBackdrop');
      const content = document.getElementById('sideMenuContent');

      if (open) {
        drawer.classList.remove('pointer-events-none');
        backdrop.classList.remove('opacity-0');
        backdrop.classList.add('opacity-100');
        content.classList.remove('translate-x-full');
      } else {
        backdrop.classList.remove('opacity-100');
        backdrop.classList.add('opacity-0');
        content.classList.add('translate-x-full');
        setTimeout(() => drawer.classList.add('pointer-events-none'), 500);
      }
    }

    function logoutSession() {
      localStorage.removeItem('el_user');
      localStorage.removeItem('el_pass');
      localStorage.removeItem('el_token');
      location.reload();
    }

    /* ---------------- تهيئة النظام عند الإقلاع ---------------- */
    document.addEventListener('DOMContentLoaded', () => {
      startLiveClock();
      renderLiquidSphere();
      renderScheduledAlertsList();

      // استعادة التفضيلات المحفوظة
      const savedTheme = localStorage.getItem('el_saved_theme');
      if (savedTheme) document.body.className = `${savedTheme} transition-all duration-700 antialiased`;

      const fAr = localStorage.getItem('el_font_ar');
      if (fAr) document.documentElement.style.setProperty('--font-ar', fAr);
      const fEn = localStorage.getItem('el_font_en');
      if (fEn) document.documentElement.style.setProperty('--font-en', fEn);

      // التحقق من الجلسة السابقة
      const savedUser = localStorage.getItem('el_user');
      const savedPass = localStorage.getItem('el_pass');

      if (savedUser && savedPass) {
        performEarthlinkLogin(savedUser, savedPass).then(() => {
          document.getElementById('loginScreen').classList.add('hidden');
          const app = document.getElementById('mainApp');
          app.classList.remove('opacity-0');
          app.classList.add('opacity-100');
          updateUI();
          initPersistentConnection();
        });
      }

      // معالج تسجيل الدخول
      document.getElementById('authForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const u = document.getElementById('loginUsername').value.trim();
        const p = document.getElementById('loginPassword').value.trim();
        const btn = document.getElementById('loginSubmitBtn');

        btn.innerHTML = `<i class="fa-solid fa-circle-notch fa-spin"></i><span>جاري التحقق الفعلي...</span>`;
        btn.disabled = true;

        const success = await performEarthlinkLogin(u, p);
        if (success) {
          playHaptic('success');
          document.getElementById('loginScreen').classList.add('opacity-0');
          setTimeout(() => {
            document.getElementById('loginScreen').classList.add('hidden');
            const app = document.getElementById('mainApp');
            app.classList.remove('opacity-0');
            app.classList.add('opacity-100');
            updateUI();
            showNotification("مرحباً بك", `تم تسجيل دخول المشترك ${subscriberData.fullName} بنجاح`, "fa-solid fa-user-check");
            initPersistentConnection();
          }, 600);
        } else {
          document.getElementById('loginErrorMsg').classList.remove('hidden');
          btn.innerHTML = `<span>دخول فوري</span><i class="fa-solid fa-fingerprint text-base"></i>`;
          btn.disabled = false;
        }
      });
    });
  </script>
