<!DOCTYPE html>
<html lang="ar" dir="rtl" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Earthlink SuperApp - Premium iOS Edition</title>

  <!-- Tailwind CSS & FontAwesome -->
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
  
  <!-- خطوط عربية وانكليزية فخمة -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Almarai:wght@300;400;700;800&family=Cairo:wght@300;500;700;900&family=Outfit:wght@300;400;600;800&family=Poppins:wght@300;500;700&family=Tajawal:wght@300;500;700;900&display=swap" rel="stylesheet">

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            iosGlass: 'rgba(255, 255, 255, 0.08)',
            iosGlassBorder: 'rgba(255, 255, 255, 0.16)',
            iosDarkGlass: 'rgba(15, 23, 42, 0.65)',
          },
          animation: {
            'glow-pulse': 'pulseGlow 3s infinite alternate',
            'float': 'float 4s ease-in-out infinite',
            'spin-slow': 'spin 12s linear infinite',
          },
          keyframes: {
            pulseGlow: {
              '0%': { boxShadow: '0 0 15px rgba(56, 189, 248, 0.3)' },
              '100%': { boxShadow: '0 0 35px rgba(56, 189, 248, 0.8)' },
            },
            float: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-6px)' },
            }
          }
        }
      }
    }
  </script>

  <style>
    :root {
      --font-ar: 'Cairo', sans-serif;
      --font-en: 'Outfit', sans-serif;
      --font-tooltip: 'Tajawal', sans-serif;
      --theme-gradient: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #090d16 100%);
      --accent-color: #38bdf8;
    }
    
    body {
      font-family: var(--font-ar);
      background: var(--theme-gradient);
      min-height: 100vh;
      color: #f8fafc;
      overflow-x: hidden;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    .font-en { font-family: var(--font-en); }
    .font-tooltip { font-family: var(--font-tooltip); }

    /* تأثيرات الزجاج الفاخرة */
    .glass-panel {
      background: rgba(22, 27, 34, 0.65);
      backdrop-filter: blur(24px) saturate(190%);
      -webkit-backdrop-filter: blur(24px) saturate(190%);
      border: 1px solid rgba(255, 255, 255, 0.12);
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.5), inset 0 1px 1px rgba(255, 255, 255, 0.2);
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.04);
      backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      transition: all 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .glass-card:active {
      transform: scale(0.97);
      background: rgba(255, 255, 255, 0.09);
    }

    /* أسطوانة كروية ثلاثية الأبعاد تحتوي على سائل متحرك */
    .liquid-sphere-wrapper {
      position: relative;
      width: 190px;
      height: 190px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, rgba(255,255,255,0.15), rgba(0,0,0,0.6));
      box-shadow: 0 15px 35px rgba(0,0,0,0.6), inset 0 0 20px rgba(255,255,255,0.2), 0 0 25px var(--accent-color);
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .liquid-canvas {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    .liquid-content {
      position: relative;
      z-index: 2;
      text-shadow: 0 2px 8px rgba(0,0,0,0.8);
    }

    /* نوتفكيشن Dynamic Island بنمط iOS */
    #iosNotification {
      transform: translateY(-160%);
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    #iosNotification.active {
      transform: translateY(0);
    }

    /* أنيميشن الأزرار التفاعلية */
    .btn-lux {
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }
    .btn-lux::after {
      content: '';
      position: absolute;
      top: -50%; left: -50%;
      width: 200%; height: 200%;
      background: linear-gradient(60deg, transparent, rgba(255,255,255,0.15), transparent);
      transform: rotate(45deg) translateY(-100%);
      transition: transform 0.6s ease;
    }
    .btn-lux:hover::after {
      transform: rotate(45deg) translateY(100%);
    }

    /* ثيمات التطبيق الثمانية الفخمة */
    body.theme-1 { --theme-gradient: radial-gradient(circle at 50% 0%, #1e1b4b 0%, #090d16 100%); --accent-color: #38bdf8; } /* Midnight Navy */
    body.theme-2 { --theme-gradient: radial-gradient(circle at 50% 0%, #31103f 0%, #0d0414 100%); --accent-color: #d946ef; } /* Cyberpunk Violet */
    body.theme-3 { --theme-gradient: radial-gradient(circle at 50% 0%, #064e3b 0%, #021a13 100%); --accent-color: #10b981; } /* Emerald Matrix */
    body.theme-4 { --theme-gradient: radial-gradient(circle at 50% 0%, #78350f 0%, #1c0a00 100%); --accent-color: #f59e0b; } /* Imperial Gold */
    body.theme-5 { --theme-gradient: radial-gradient(circle at 50% 0%, #881337 0%, #1a0208 100%); --accent-color: #f43f5e; } /* Crimson Velvet */
    body.theme-6 { --theme-gradient: radial-gradient(circle at 50% 0%, #134e4a 0%, #041d1a 100%); --accent-color: #14b8a6; } /* Aurora Ocean */
    body.theme-7 { --theme-gradient: radial-gradient(circle at 50% 0%, #27272a 0%, #09090b 100%); --accent-color: #e4e4e7; } /* Titanium Stealth */
    body.theme-8 { --theme-gradient: radial-gradient(circle at 50% 0%, #4c1d95 0%, #1e0838 100%); --accent-color: #8b5cf6; } /* Royal Nebula */

    /* شريط التمرير المخصص الفاخر */
    ::-webkit-scrollbar { width: 5px; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.2); border-radius: 10px; }
  </style>
</head>

<body class="theme-1 transition-all duration-700 antialiased">

  <!-- إشعار iOS Dynamic Island العلوي -->
  <div id="iosNotification" class="fixed top-3 inset-x-0 mx-auto w-[92%] max-w-md z-50 pointer-events-none">
    <div class="glass-panel rounded-full px-5 py-3 shadow-2xl flex items-center justify-between border border-cyan-400/30">
      <div class="flex items-center space-x-3 space-x-reverse">
        <div id="notifIcon" class="w-9 h-9 rounded-full bg-cyan-500/20 text-cyan-400 flex items-center justify-center text-lg animate-pulse">
          <i class="fa-solid fa-bell"></i>
        </div>
        <div>
          <h4 id="notifTitle" class="text-xs font-bold text-gray-200">تنبيه النظام</h4>
          <p id="notifBody" class="text-[11px] text-gray-400 font-tooltip">تمت العملية بنجاح</p>
        </div>
      </div>
      <span class="text-[10px] text-gray-500 font-en">الآن</span>
    </div>
  </div>

  <!-- خلفية الجزيئات الحركية ثلاثية الأبعاد -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden opacity-30">
    <div class="absolute -top-32 -left-32 w-96 h-96 bg-cyan-500/20 rounded-full blur-[100px] animate-float"></div>
    <div class="absolute top-1/2 -right-32 w-96 h-96 bg-purple-500/20 rounded-full blur-[120px] animate-pulse"></div>
  </div>

  <!-- شاشة تسجيل الدخول الأسطورية -->
  <section id="loginScreen" class="fixed inset-0 z-40 flex items-center justify-center p-4 bg-black/85 backdrop-blur-3xl transition-opacity duration-700">
    <div class="glass-panel w-full max-w-sm rounded-3xl p-7 relative border border-white/20 shadow-2xl text-center">
      <div class="w-20 h-20 mx-auto mb-4 rounded-2xl p-1 bg-gradient-to-tr from-cyan-500 to-indigo-600 shadow-xl shadow-cyan-500/30 flex items-center justify-center animate-bounce">
        <i class="fa-solid fa-satellite-dish text-3xl text-white"></i>
      </div>
      <h2 class="text-2xl font-black tracking-wide text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-200 mb-1">EARTHLINK PORTAL</h2>
      <p class="text-xs text-gray-400 mb-6 font-tooltip">سجّل دخولك للوصول إلى لوحة المزامنة اللحظية الفاخرة</p>

      <form id="authForm" class="space-y-4">
        <div class="relative">
          <i class="fa-solid fa-user absolute right-4 top-3.5 text-gray-400"></i>
          <input type="text" id="loginUsername" required placeholder="اسم المستخدم (User ID)" dir="ltr"
                 class="w-full bg-white/5 border border-white/10 rounded-2xl py-3 pr-11 pl-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition" />
        </div>
        <div class="relative">
          <i class="fa-solid fa-lock absolute right-4 top-3.5 text-gray-400"></i>
          <input type="password" id="loginPassword" required placeholder="كلمة المرور (Password)" dir="ltr"
                 class="w-full bg-white/5 border border-white/10 rounded-2xl py-3 pr-11 pl-4 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition" />
        </div>

        <button type="submit" id="loginSubmitBtn" class="w-full btn-lux py-3.5 rounded-2xl bg-gradient-to-r from-cyan-500 to-blue-600 font-bold text-sm tracking-wide shadow-lg shadow-cyan-500/25 flex items-center justify-center space-x-2 space-x-reverse">
          <span>دخول فوري</span>
          <i class="fa-solid fa-fingerprint text-base"></i>
        </button>
      </form>
      <div id="loginErrorMsg" class="mt-3 text-xs text-rose-400 font-bold hidden">بيانات الدخول غير صحيحة، يرجى التحقق.</div>
    </div>
  </section>

  <!-- التطبيق الرئيسي (الهيكل الكامل) -->
  <div id="mainApp" class="relative z-10 flex flex-col min-h-screen pb-24 opacity-0 transition-opacity duration-700">
    
    <!-- شريط الرأس الفخم بنمط iOS -->
    <header class="sticky top-0 z-30 glass-panel border-b border-white/10 px-4 py-3 mx-2 mt-2 rounded-2xl flex items-center justify-between">
      <!-- البروفايل وفتح القائمة الجانبية -->
      <div class="flex items-center space-x-3 space-x-reverse cursor-pointer" onclick="toggleSidebar(true)">
        <div class="relative">
          <img id="headerUserAvatar" src="https://user.earthlink.iq/accountImages/138.png" 
               class="w-10 h-10 rounded-full border-2 border-cyan-400 p-0.5 object-cover shadow-lg" alt="User Avatar" />
          <span id="headerOnlineDot" class="absolute bottom-0 right-0 w-3 h-3 bg-emerald-500 border-2 border-black rounded-full animate-ping"></span>
        </div>
        <div>
          <h3 id="headerFullName" class="text-xs font-bold leading-tight">سيد جعفر</h3>
          <span id="headerStatusBadge" class="text-[10px] px-2 py-0.5 rounded-full font-en font-bold uppercase bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">ONLINE</span>
        </div>
      </div>

      <!-- الساعة بنظام 12 ساعة الرقمية المتدفقة -->
      <div class="text-center">
        <div id="liveClock" class="font-en text-sm font-black tracking-wider text-cyan-300">12:00:00 PM</div>
        <div class="text-[9px] text-gray-400 uppercase tracking-widest font-en">Earthlink Sync</div>
      </div>

      <!-- أزرار الإعدادات وتبديل الوضع الليلي والنهاري الفاخر -->
      <div class="flex items-center space-x-2 space-x-reverse">
        <button onclick="toggleDayNightMode()" class="w-9 h-9 rounded-xl glass-card flex items-center justify-center text-amber-300 hover:text-amber-400 hover:rotate-45 transition duration-500">
          <i id="dayNightIcon" class="fa-solid fa-moon text-sm"></i>
        </button>
        <button onclick="switchTab('settings')" class="w-9 h-9 rounded-xl glass-card flex items-center justify-center text-cyan-300 hover:rotate-90 transition duration-500">
          <i class="fa-solid fa-gear text-sm"></i>
        </button>
      </div>
    </header>

    <!-- عداد المؤشرات الشبكية السريعة التفاعلية (Ping, Frequency, Data) -->
    <div class="grid grid-cols-3 gap-2 px-3 mt-3">
      <div class="glass-card rounded-2xl p-2.5 text-center">
        <span class="text-[10px] text-gray-400 block font-tooltip">سرعة البنك</span>
        <div class="flex items-center justify-center space-x-1 space-x-reverse text-cyan-400 font-en font-bold text-xs mt-0.5">
          <i class="fa-solid fa-bolt text-[10px] animate-pulse"></i>
          <span id="metricPing">18 ms</span>
        </div>
      </div>
      <div class="glass-card rounded-2xl p-2.5 text-center">
        <span class="text-[10px] text-gray-400 block font-tooltip">التردد النشط</span>
        <div class="flex items-center justify-center space-x-1 space-x-reverse text-purple-400 font-en font-bold text-xs mt-0.5">
          <i class="fa-solid fa-wave-square text-[10px]"></i>
          <span>5.8 GHz</span>
        </div>
      </div>
      <div class="glass-card rounded-2xl p-2.5 text-center">
        <span class="text-[10px] text-gray-400 block font-tooltip">الاستهلاك التقديري</span>
        <div class="flex items-center justify-center space-x-1 space-x-reverse text-emerald-400 font-en font-bold text-xs mt-0.5">
          <i class="fa-solid fa-cloud-arrow-down text-[10px]"></i>
          <span id="metricGigabytes">342 GB</span>
        </div>
      </div>
    </div>

    <!-- المحتوى القابل للتبديل للأقسام الرئيسية -->
    <main class="flex-1 px-3 mt-3">

      <!-- ================= 1. القسم الرئيسي (Home) ================= -->
      <section id="tab-home" class="tab-content space-y-4">
        
        <!-- الكارد ثلاثي الأبعاد مع السائل التفاعلي للأيام المتبقية -->
        <div class="glass-panel rounded-3xl p-5 border border-white/15 relative overflow-hidden shadow-2xl flex flex-col items-center">
          <div class="text-center mb-3">
            <span class="text-[11px] text-cyan-300 uppercase tracking-widest font-en font-semibold">Subscription Fuel</span>
            <h4 class="text-base font-black">العداد الزمني للاشتراك</h4>
          </div>

          <!-- مجسم السائل الدائري -->
          <div class="liquid-sphere-wrapper mb-4">
            <canvas id="liquidCanvas" class="liquid-canvas" width="190" height="190"></canvas>
            <div class="liquid-content text-center">
              <span class="text-3xl font-black font-en tracking-tight text-white drop-shadow-md" id="sphereDaysVal">13</span>
              <span class="block text-[11px] font-bold text-cyan-200">يوم متبقي</span>
              <span class="text-[9px] font-en opacity-75 text-gray-300" id="spherePercent">43%</span>
            </div>
          </div>

          <!-- معلومات الباقة المختصرة في الأسفل -->
          <div class="w-full grid grid-cols-2 gap-2 pt-2 border-t border-white/10 text-center">
            <div class="glass-card p-2 rounded-xl">
              <span class="text-[10px] text-gray-400 block">نوع الاشتراك</span>
              <span id="homePackageName" class="font-bold text-xs text-white">Plus</span>
            </div>
            <div class="glass-card p-2 rounded-xl">
              <span class="text-[10px] text-gray-400 block">السعر الشهري</span>
              <span id="homePackagePrice" class="font-bold text-xs text-amber-300 font-en">35,000 IQD</span>
            </div>
          </div>
        </div>

        <!-- كارد تفاصيل وتاريخ الانتهاء بنمط فاخر -->
        <div class="glass-panel rounded-2xl p-4 flex items-center justify-between border border-cyan-500/20">
          <div class="flex items-center space-x-3 space-x-reverse">
            <div class="w-12 h-12 rounded-xl bg-cyan-500/10 flex items-center justify-center text-cyan-400 text-xl border border-cyan-500/30">
              <i class="fa-solid fa-calendar-check"></i>
            </div>
            <div>
              <span class="text-[10px] text-gray-400 block font-tooltip">تاريخ نفاذ الصلاحية الفعلي</span>
              <span id="homeExpireDate" class="text-xs font-bold text-gray-100 font-en">01/11/2026 07:45:27 م</span>
            </div>
          </div>
          <button onclick="refreshDataInstant()" title="تحديث مباشر" class="w-9 h-9 rounded-full glass-card text-cyan-300 flex items-center justify-center active:rotate-180 transition duration-500">
            <i class="fa-solid fa-arrows-rotate text-sm"></i>
          </button>
        </div>
      </section>

      <!-- ================= 2. قسم البيانات الكاملة (Data) ================= -->
      <section id="tab-data" class="tab-content hidden space-y-3">
        <div class="flex items-center justify-between px-1">
          <div>
            <h3 class="text-base font-black">بيانات المشترك الدقيقة</h3>
            <p class="text-[10px] text-gray-400 font-tooltip">انقر على أي كارد لنسخ القيمة فورياً</p>
          </div>
          <button onclick="copyFullReport()" class="btn-lux px-3 py-1.5 rounded-xl bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 text-xs flex items-center space-x-1 space-x-reverse">
            <i class="fa-solid fa-copy"></i>
            <span>نسخ التقرير كاملاً</span>
          </button>
        </div>

        <!-- شبكة البطاقات الزجاجية القابلة للنسخ -->
        <div class="grid grid-cols-1 gap-2 text-xs" id="cardsContainer">
          <!-- تُحقن عبر الـ JavaScript ديناميكياً -->
        </div>

        <!-- زر الإرسال المباشر لديسكورد -->
        <button onclick="sendReportToDiscordManual()" class="w-full btn-lux py-3 rounded-2xl bg-indigo-600/80 hover:bg-indigo-600 border border-indigo-400/40 text-white font-bold text-xs shadow-lg flex items-center justify-center space-x-2 space-x-reverse mt-2">
          <i class="fa-brands fa-discord text-base"></i>
          <span>إرسال التقرير الآن إلى Webhook ديسكورد</span>
        </button>
      </section>

      <!-- ================= 3. قسم التنبيهات والأوامر (Alerts) ================= -->
      <section id="tab-alerts" class="tab-content hidden space-y-4">
        <div class="glass-panel rounded-2xl p-4 border border-white/10 space-y-4">
          <div>
            <h3 class="text-sm font-bold flex items-center space-x-2 space-x-reverse text-cyan-300">
              <i class="fa-solid fa-paper-plane"></i>
              <span>الأوامر المباشرة والتنبيه المجدول</span>
            </h3>
            <p class="text-[10px] text-gray-400 mt-1">إرسال تقرير فوري أو جدولة تنبيه يتم إرساله لتلغرام أو ديسكورد عند وقت محدد حتى وإن غادرت التطبيق.</p>
          </div>

          <!-- إرسال فوري -->
          <div class="glass-card p-3 rounded-xl flex items-center justify-between">
            <div>
              <span class="text-xs font-bold block">إرسال تقرير فوري (Webhook)</span>
              <span class="text-[10px] text-gray-400">إرسال لـ Discord المسجل فورياً بنقرة واحدة</span>
            </div>
            <button onclick="sendReportToDiscordManual()" class="btn-lux px-3 py-2 bg-cyan-500 text-black font-bold text-xs rounded-xl shadow-md">
              إرسال فوري
            </button>
          </div>

          <!-- جدولة تنبيه -->
          <div class="space-y-3 pt-2 border-t border-white/10">
            <span class="text-xs font-bold text-gray-200 block">جدولة تنبيه زمني لاشتراكك</span>
            
            <div class="grid grid-cols-2 gap-2 text-xs">
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">حدد التاريخ</label>
                <input type="date" id="schedDate" class="w-full bg-white/5 border border-white/10 rounded-xl p-2 text-white focus:outline-none focus:border-cyan-400 font-en" />
              </div>
              <div>
                <label class="text-[10px] text-gray-400 block mb-1">حدد الوقت</label>
                <input type="time" id="schedTime" class="w-full bg-white/5 border border-white/10 rounded-xl p-2 text-white focus:outline-none focus:border-cyan-400 font-en" />
              </div>
            </div>

            <div>
              <label class="text-[10px] text-gray-400 block mb-1">طريقة الإرسال</label>
              <select id="schedMethod" class="w-full bg-slate-900 border border-white/10 rounded-xl p-2 text-xs text-white focus:outline-none focus:border-cyan-400">
                <option value="both">إرسال عبر (ديسكورد + تلغرام)</option>
                <option value="telegram">تلغرام بوت فقط (Telegram Bot)</option>
                <option value="discord">ديسكورد فقط (Discord Webhook)</option>
              </select>
            </div>

            <button onclick="scheduleAlertSubmit()" class="w-full btn-lux py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 font-bold text-xs text-white shadow-lg flex items-center justify-center space-x-2 space-x-reverse">
              <i class="fa-solid fa-clock"></i>
              <span>تثبيت التنبيه المجدول</span>
            </button>
          </div>
        </div>

        <div id="scheduledAlertsList" class="space-y-2">
          <!-- التنبيهات المجدولة المحفوظة -->
        </div>
      </section>

      <!-- ================= 4. قسم الإعدادات وتخصيص الثيم (Settings) ================= -->
      <section id="tab-settings" class="tab-content hidden space-y-4">
        <div class="glass-panel rounded-2xl p-4 border border-white/10 space-y-4">
          <h3 class="text-sm font-bold text-cyan-300">تخصيص المظهر وتجربة الاستخدام</h3>

          <!-- تبديل الثيمات الفخمة الثمانية -->
          <div>
