    /* ---------------- محاكاة ومحرك السائل الدائري الملحمي (Liquid Sphere) ---------------- */
    let waveOffset = 0;
    function renderLiquidSphere() {
      const canvas = document.getElementById('liquidCanvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      const width = canvas.width;
      const height = canvas.height;

      const days = parseInt(subscriberData.activeDaysLeft) || 13;
      const percentage = Math.min(Math.max((days / 30), 0.05), 0.95);
      const targetHeight = height - (height * percentage);

      ctx.clearRect(0, 0, width, height);

      // رسم السائل مع موجتين هيدروليكية
      ctx.beginPath();
      ctx.moveTo(0, height);
      for (let x = 0; x <= width; x++) {
        const y1 = Math.sin((x * 0.04) + waveOffset) * 6;
        const y2 = Math.cos((x * 0.03) - waveOffset) * 4;
        ctx.lineTo(x, targetHeight + y1 + y2);
      }
      ctx.lineTo(width, height);
      ctx.closePath();

      // تدرج السائل الفخم المتطابق مع الثيم
      const gradient = ctx.createLinearGradient(0, targetHeight, 0, height);
      gradient.addColorStop(0, 'rgba(56, 189, 248, 0.85)');
      gradient.addColorStop(0.5, 'rgba(37, 99, 235, 0.7)');
      gradient.addColorStop(1, 'rgba(15, 23, 42, 0.95)');
      ctx.fillStyle = gradient;
      ctx.fill();

      waveOffset += 0.05;
      requestAnimationFrame(renderLiquidSphere);
    }

